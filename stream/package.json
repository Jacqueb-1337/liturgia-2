{
  "name": "liturgia-stream",
  "version": "0.1.0",
  "private": true,
  "description": "Liturgia Worship streaming companion",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check settingsStore.js && node --check ffmpegRuntime.js && node --check outputManager.js",
    "build": "electron-builder --win nsis"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0"
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^26.4.0"
  },
  "build": {
    "appId": "com.jacqueb.liturgia.stream",
    "productName": "Liturgia Stream",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/**"
    ]
  }
}
