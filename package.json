{
  "name": "liturgia",
  "version": "5.7.0",
  "author": "Jacqueb <contact@jacqueb.me>",
  "main": "main.js",
  "description": "Liturgia • Worship — presentation software",
  "scripts": {
    "start": "electron .",
    "dev": "set NODE_ENV=development && electron .",
    "prebuild": "node scripts/clean-old-exe.js",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --mac || true && electron-builder --linux || true && electron-builder --win || true",
    "make-icon": "node scripts/make-icon.js",
    "rebuild-native": "npx electron-rebuild -f -w keytar --module-dir .",
    "test": "jest --runInBand",
    "release": "node scripts/release-bump.js",
    "ws:check": "node scripts/check-websocket-server.js",
    "ws:restart": "node scripts/restart-websocket-server.js",
    "ws:test": "node scripts/test-ws-endpoints.js"
  },
  "jest": {
    "testEnvironment": "jsdom"
  },
  "build": {
    "appId": "com.jacqueb.liturgia",
    "productName": "Liturgia",
    "icon": "build/icon",
    "artifactName": "liturgia.${ext}",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo"
    },
    "fileAssociations": [
      {
        "ext": "litsch",
        "name": "Liturgia Schedule",
        "description": "Liturgia Worship Schedule",
        "role": "Editor"
      },
      {
        "ext": "litsong",
        "name": "Liturgia Songs",
        "description": "Liturgia Song Collection",
        "role": "Editor"
      },
      {
        "ext": "litrep",
        "name": "Liturgia Report",
        "description": "Liturgia Diagnostic Report",
        "role": "Viewer"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Liturgia",
      "runAfterFinish": false,
      "include": "build/installer.nsh"
    },
    "files": [
      "**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/test",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "speech/speechSidecarManager.js",
      "speech/backend/**/*"
    ],
    "extraResources": [
      {
        "from": "build/extraResources",
        "to": "resources"
      },
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ]
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^26.4.0",
    "glob": "^10.3.10",
    "jest": "^29.6.1",
    "jest-environment-jsdom": "^30.2.0",
    "jimp": "^1.6.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "optionalDependencies": {
    "electron-rebuild": "^3.2.5"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "adm-zip": "^0.5.16",
    "bonjour-service": "^1.3.0",
    "core-util-is": "^1.0.3",
    "http-server": "^14.1.1",
    "keytar": "^7.7.0",
    "node-fetch": "^2.6.7",
    "rtf-parser": "^1.3.3",
    "sql.js": "^1.8.0",
    "sudo-prompt": "^9.2.1",
    "ws": "^8.19.0"
  }
}
